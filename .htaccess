# MGD Skid Loader Services - IONOS production rules
Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
RewriteEngine On

# Canonical HTTPS + non-www hostname.
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^mgdskidloader\.com$ [NC]
RewriteRule ^ https://mgdskidloader.com%{REQUEST_URI} [R=301,L]

# Consolidate legacy/duplicate service URLs.
RewriteRule ^services/concrete-asphalt-removal/?$ /services/asphalt-concrete-removal/ [R=301,L]
RewriteRule ^services/site-preparation/?$ /services/building-site-readiness/ [R=301,L]
</IfModule>

<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/css "access plus 30 days"
ExpiresByType application/javascript "access plus 30 days"
ExpiresByType image/webp "access plus 1 year"
ExpiresByType image/jpeg "access plus 1 year"
ExpiresByType image/png "access plus 1 year"
ExpiresByType image/svg+xml "access plus 1 year"
ExpiresByType video/mp4 "access plus 30 days"
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
